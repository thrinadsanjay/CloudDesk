# Public URL port for the browser gateway
WEB_PORT=9080

# Optional extra password required before an RDP session is created.
# Leave empty to allow any valid Linux/xrdp login.
GATE_PASSWORD=

# RDP target. From Docker, host.docker.internal is the machine running xrdp.
RDP_HOST=host.docker.internal
RDP_PORT=3389
RDP_SECURITY=any
RDP_IGNORE_CERT=true

# Optional default Linux username shown on the login form
RDP_USERNAME=

# 32-character AES-256 key used to encrypt Guacamole connection tokens.
# scripts/start.sh generates one automatically if missing.
TOKEN_KEY=

# Desktop label shown in the UI
DESKTOP_NAME=Debian Desktop

# Seeded into data/users.json on first start as an administrator.
# After that, change the password under Users in the admin console.
ADMIN_USER=admin
ADMIN_PASSWORD=



